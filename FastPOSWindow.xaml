<Window x:Class="AccountingSystem.UI.FastPOSWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="نظام البيع السريع - Fast POS" Height="750" Width="1150"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- الشريط العلوي: العملة والباركوم -->
            <RowDefinition Height="*"/>
            <!-- جدول السلة -->
            <RowDefinition Height="Auto"/>
            <!-- شريط الإحصائيات الفورية -->
            <RowDefinition Height="Auto"/>
            <!-- الإجماليات وزر الدفع -->
        </Grid.RowDefinitions>

        <!-- 1. القسم العلوي -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtCurrencyLabel" Text="العملة: YER" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="الباركود (Enter):" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="txtBarcode" Width="300" Height="35" FontSize="16" VerticalContentAlignment="Center" KeyDown="txtBarcode_KeyDown" TextChanged="TxtBarcode_TextChanged"/>
                <Button Content="بحث (F4)" Width="90" Height="35" Margin="10,0,0,0" Click="BtnSearch_Click"/>
            </StackPanel>

            <Button Grid.Column="2" Content="متبقي/إرجاع (F7)" Width="120" Height="35" Click="Button_Click"/>
        </Grid>

        <!-- 2. جدول سلة المبيعات -->
        <DataGrid x:Name="dgCart" 
                  Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  SelectionMode="Single"
                  PreviewKeyDown="dgCart_PreviewKeyDown"
                  FontSize="14" RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" IsReadOnly="True" Width="1.2*"/>
                <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ItemName}" IsReadOnly="True" Width="2.5*"/>
                <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" IsReadOnly="True" Width="1*"/>

                <!-- الكمية -->
                <DataGridTextColumn Header="الكمية" 
                                    Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" 
                                    IsReadOnly="False" 
                                    Width="1*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <!-- السعر -->
                <DataGridTextColumn Header="السعر" 
                                    Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" 
                                    IsReadOnly="False" 
                                    Width="1.2*"/>

                <!-- الإجمالي -->
                <DataGridTextColumn Header="الإجمالي" 
                                    Binding="{Binding Total, StringFormat={}{0:N2}}" 
                                    IsReadOnly="True" 
                                    Width="1.5*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="DarkGreen"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 3. ملخص الأصناف والكميات -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
            <TextBlock Text="عدد الأصناف: " FontSize="14"/>
            <TextBlock x:Name="txtItemsCount" Text="0" FontSize="14" FontWeight="Bold" Margin="0,0,20,0"/>

            <TextBlock Text="إجمالي القطع: " FontSize="14"/>
            <TextBlock x:Name="txtTotalQuantity" Text="0" FontSize="14" FontWeight="Bold"/>
        </StackPanel>

        <!-- 4. القسم السفلي (الحسابات والدفع) -->
        <Border Grid.Row="3" Background="#F0F0F0" Padding="15" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- طرق الدفع والخصم -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="rbCash" Content="نقداً (F1)" IsChecked="True" FontSize="14" FontWeight="Bold" Margin="0,0,15,0"/>
                        <RadioButton x:Name="rbCard" Content="شبكة/بطاقة (F2)" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="الخصم: " FontSize="14" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDiscount" IsEnabled="False" Text="0.00" Width="80" Height="30" FontSize="14" TextAlignment="Center" TextChanged="txtDiscount_TextChanged"/>
                        <Button Content="طلب خصم" Width="85" Height="30" Margin="5,0,0,0" Click="BtnApplyDiscount_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- الإجماليات -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="المجموع: " FontSize="14"/>
                        <TextBlock x:Name="lblTotalSales" Text="0.00" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="الصافي: " FontSize="18" FontWeight="Bold" Foreground="DarkGreen"/>
                        <TextBlock x:Name="lblNetAmount" Text="0.00 YER" FontSize="18" FontWeight="Bold" Foreground="DarkGreen"/>
                    </StackPanel>
                    <!-- عنصر مخفي متوافق مع الكود -->
                    <TextBlock x:Name="txtGrandTotal" Visibility="Collapsed"/>
                </StackPanel>

                <!-- زر حفظ وطباعة -->
                <Button Grid.Column="2" Content="حفظ وطباعة (F12)" Background="#28A745" Foreground="White" FontSize="18" FontWeight="Bold" Width="200" Height="50" Click="BtnSave_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>