<Window x:Class="accounting_project.Views.AccountSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بحث عن حساب (تحديد متعدد)" Height="450" Width="550"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="txtSearch" Height="30" Margin="0,0,0,10" 
                 TextChanged="TxtSearch_TextChanged" 
                 VerticalContentAlignment="Center" Padding="5"
                 ToolTip="اكتب رقم أو اسم الحساب للبحث..."/>

        <!-- تغيير SelectionMode إلى Extended لتفعيل التحديد المتعدد -->
        <DataGrid x:Name="dgAccounts" Grid.Row="1" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Extended" 
                  MouseDoubleClick="DgAccounts_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم الحساب" Binding="{Binding AccountCode}" Width="150"/>
                <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountNameAr}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="يمكنك تحديد أكثر من حساب باستخدام Ctrl أو Shift" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="Gray" FontSize="11"/>
            <Button Content="إضافة المحددة" Click="BtnSelect_Click" Width="100" Height="30" Margin="5,0" Background="#27ae60" Foreground="White"/>
            <Button Content="إلغاء" Click="BtnCancel_Click" Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</Window>