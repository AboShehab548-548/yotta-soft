<Window x:Class="AccountingSystem.UI.PendingInvoicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الفواتير المعلقة" Height="450" Width="700"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="قائمة الفواتير المعلقة للوردية الحالية" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid x:Name="dgPendingInvoices" Grid.Row="1" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single" FontSize="13" RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم التعليق" Binding="{Binding PendingInvoiceID}" Width="90"/>
                <DataGridTextColumn Header="اسم العميل / ملاحظة" Binding="{Binding CustomerName}" Width="160"/>
                <!-- أضف هذا العمود -->
                <DataGridTextColumn Header="وقت التعليق" Binding="{Binding HoldDate, StringFormat={}{0:hh:mm tt}}" Width="110"/>
                <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding ItemCount}" Width="90"/>
                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat={}{0:N2} ر.س}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnRecall" Content="استرجاع الفاتورة (Enter)" Width="160" Height="38" Background="#2C3E50" Foreground="White" FontWeight="Bold" Click="BtnRecall_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnDelete" Content="حذف" Width="90" Height="38" Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="BtnDelete_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="إلغاء" Width="90" Height="38" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>