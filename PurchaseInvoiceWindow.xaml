<Window x:Class="accounting_project.PurchaseInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فاتورة شراء جديدة - وتتبع الصلاحية" Height="750" Width="1100"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="786*"/>
            <ColumnDefinition Width="277*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- بيانات الفاتورة والمورد -->
            <RowDefinition Height="Auto"/>
            <!-- إضافة أصناف -->
            <RowDefinition Height="*"/>
            <!-- جدول الأصناف -->
            <RowDefinition Height="Auto"/>
            <!-- الإجماليات والحفظ -->
        </Grid.RowDefinitions>

        <!-- 1. بيانات الفاتورة والمورد -->
        <GroupBox Header="بيانات الفاتورة والمورد" Grid.Row="0" Margin="0,0,0,10" Padding="10" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <TextBlock Text="المورد:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox x:Name="cmbSuppliers" Grid.Column="1" DisplayMemberPath="SupplierName" SelectedValuePath="SupplierID" Margin="5"/>

                <TextBlock Text="رقم الفاتورة:" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="txtInvoiceNumber" Grid.Column="3" Margin="5" VerticalContentAlignment="Center"/>

                <TextBlock Text="تاريخ الفاتورة:" Grid.Column="4" VerticalAlignment="Center" Margin="5"/>
                <DatePicker x:Name="dpInvoiceDate" Grid.Column="5" Margin="5" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- 2. إدخال السلع وتواريخ الانتهاء -->
        <GroupBox Header="إضافة صنف للفاتورة" Grid.Row="1" Margin="0,0,0,10" Padding="10" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <TextBlock Text="الباركود / الصنف" Grid.Column="0" Margin="5"/>
                <TextBlock Text="الكمية" Grid.Column="1" Margin="5"/>
                <TextBlock Text="سعر الشراء" Grid.Column="2" Margin="5"/>
                <TextBlock Text="تاريخ الانتهاء" Grid.Column="3" Margin="5"/>

                <TextBox x:Name="txtItemSearch" Grid.Row="1" Grid.Column="0" Margin="5" KeyDown="TxtItemSearch_KeyDown"/>
                <TextBox x:Name="txtQuantity" Grid.Row="1" Grid.Column="1" Margin="5" Text="1"/>
                <TextBox x:Name="txtCostPrice" Grid.Row="1" Grid.Column="2" Margin="5"/>
                <DatePicker x:Name="dpExpiryDate" Grid.Row="1" Grid.Column="3" Margin="5"/>

                <Button Grid.Row="1" Grid.Column="4" Content="إضافة (Enter)" Margin="5" Background="#007ACC" Foreground="White" Click="BtnAddItem_Click"/>
            </Grid>
        </GroupBox>

        <!-- 3. جدول الأصناف -->
        <DataGrid x:Name="dgPurchaseItems" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" FontSize="14" Grid.ColumnSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ItemName}" Width="2.5*"/>
                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="1*"/>
                <DataGridTextColumn Header="سعر الشراء" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="1*"/>
                <DataGridTextColumn Header="رقم الدفعة (Batch)" Binding="{Binding BatchNumber}" Width="1.2*"/>
                <DataGridTextColumn Header="تاريخ الانتهاء" Binding="{Binding ExpiryDate, StringFormat={}{0:yyyy-MM-dd}}" Width="1.5*"/>
                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPrice, StringFormat={}{0:N2}}" IsReadOnly="True" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. الإجماليات والدفع -->
        <Border Grid.Row="3" Background="#F8F9FA" Margin="0,10,0,0" Padding="10" CornerRadius="5" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="المبلغ المدفوع: " FontSize="14" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtPaidAmount" Width="120" Height="30" FontSize="14" Margin="5,0,15,0" TextChanged="TxtPaidAmount_TextChanged"/>
                    <TextBlock Text=" المتبقي للمورد: " FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblRemainingAmount" Text="0.00" FontSize="14" FontWeight="Bold" Foreground="Red" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="إجمالي الفاتورة: " FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="lblTotalInvoice" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="DarkGreen"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Content="حفظ وترحيل الفاتورة" Width="180" Height="45" Background="#28A745" Foreground="White" FontSize="16" FontWeight="Bold" Margin="15,0,0,0" Click="BtnSavePurchase_Click" />

            </Grid>
        </Border>
    </Grid>
</Window>