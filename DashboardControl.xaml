<UserControl x:Class="AccountingSystem.UI.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- كروت الإحصائيات -->
            <RowDefinition Height="*"/>
            <!-- جداول النواقص والأكثر مبيعاً -->
        </Grid.RowDefinitions>

        <!-- الكروت الإحصائية -->
        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,20">
            <!-- مبيعات اليوم -->
            <Border Background="#28A745" CornerRadius="8" Padding="15" Margin="5">
                <StackPanel>
                    <TextBlock Text="مبيعات اليوم" Foreground="White" FontSize="14"/>
                    <TextBlock x:Name="lblTodaySales" Text="0.00 YER" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- مبيعات الشهر -->
            <Border Background="#17A2B8" CornerRadius="8" Padding="15" Margin="5">
                <StackPanel>
                    <TextBlock Text="مبيعات الشهر الحالي" Foreground="White" FontSize="14"/>
                    <TextBlock x:Name="lblMonthlySales" Text="0.00 YER" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- نواقص المخزون -->
            <Border Background="#DC3545" CornerRadius="8" Padding="15" Margin="5">
                <StackPanel>
                    <TextBlock Text="أصناف وصلت حد الطلب" Foreground="White" FontSize="14"/>
                    <TextBlock x:Name="lblLowStockCount" Text="0 صنف" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- الجداول الإحصائية -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- الأكثر مبيعاً -->
            <GroupBox Header="الأصناف الأكثر مبيعاً" Grid.Column="0" Margin="5" FontSize="14" FontWeight="Bold">
                <DataGrid x:Name="dgTopSelling" AutoGenerateColumns="True" IsReadOnly="True" Margin="5"/>
            </GroupBox>

            <!-- نواقص المخزون -->
            <GroupBox Header="تنبيهات نواقص المخزون" Grid.Column="1" Margin="5" FontSize="14" FontWeight="Bold" Foreground="#DC3545">
                <DataGrid x:Name="dgLowStock" AutoGenerateColumns="True" IsReadOnly="True" Margin="5"/>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>