<Window x:Class="accounting_project.Views.BaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام الأونكس المحاسبي المطور" Height="700" Width="1050"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        Background="#F1F5F9" FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <!-- 1. الشريط العلوي للعنوان -->
            <RowDefinition Height="48"/>
            <!-- 2. شريط الأزرار والأدوات الثابت -->
            <RowDefinition Height="*"/>
            <!-- 3. المحتوى المتغير للشاشة -->
            <RowDefinition Height="28"/>
            <!-- 4. شريط الحالة والسفلية -->
        </Grid.RowDefinitions>

        <!-- 1. الشريط العلوي (Onyx Header Style) -->
        <Border Grid.Row="0" Background="#0F172A">
            <Grid Margin="12,0">
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}" 
                           Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Onyx ERP - النسخة الاحترافية" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. شريط الأدوات الثابت (ToolBar - جديد، حفظ، تعديل، حذف، طباعة، خروج) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="جديد (F2)" Width="80" Height="30" Margin="0,0,4,0" Background="#2563EB" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="حفظ (F10)" Width="80" Height="30" Margin="0,0,4,0" Background="#16A34A" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="تعديل" Width="75" Height="30" Margin="0,0,4,0" Background="#D97706" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="حذف" Width="75" Height="30" Margin="0,0,4,0" Background="#DC2626" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="استعراض" Width="80" Height="30" Margin="0,0,15,0" Background="#475569" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="طباعة" Width="75" Height="30" Margin="0,0,4,0" Background="#0E7490" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="خروج (Esc)" Width="80" Height="30" Background="#334155" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- 3. مساحة المحتوى المتغير (سيتم حقن تفاصيل كل شاشة هنا) -->
        <ContentPresenter Grid.Row="2" Margin="10"/>

        <!-- 4. شريط الحالة السفلي (Status Bar) -->
        <Border Grid.Row="3" Background="#1E293B">
            <Grid Margin="12,0">
                <TextBlock Text="جاهز للعمل - قاعدة البيانات متصلة" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="11"/>
                <TextBlock Text="المستخدم النشط: النظام العام" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>