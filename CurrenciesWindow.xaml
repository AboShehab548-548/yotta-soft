<Window x:Class="accounting_project.CurrenciesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تهيئة النظام - التهيئة - تهيئة العملات" Height="700" Width="950"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="MandatoryTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFE0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="NormalTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- مسار الشاشة -->
        <Border Grid.Row="0" Background="#EFEFEF" Padding="8" Margin="0,0,0,10" BorderBrush="#DDD" BorderThickness="1">
            <TextBlock Text="تهيئة النظام ◄ التهيئة ◄ تهيئة العملات" FontWeight="Bold" Foreground="#333"/>
        </Border>

        <!-- حقول الإدخال -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <UniformGrid Columns="2" Margin="0,2">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="الرقم:"/>
                        <Run Text="*" Foreground="Red" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBox x:Name="txtCurrencyID" Style="{StaticResource MandatoryTextBox}" LostFocus="TxtCurrencyID_LostFocus"/>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,2">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="اسم العملة:"/>
                        <Run Text="*" Foreground="Red" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBox x:Name="txtCurrencyName" Style="{StaticResource MandatoryTextBox}"/>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,2">
                    <TextBlock Text="رمز العملة:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtSymbol" Style="{StaticResource NormalTextBox}"/>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,2">
                    <TextBlock Text="الاسم الأجنبي:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtForeignName" Style="{StaticResource NormalTextBox}"/>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,5">
                    <TextBlock Text=""/>
                    <CheckBox x:Name="chkIsPrimary" Content="عملة الأساس (المحلية)" FontWeight="Bold"/>
                </UniformGrid>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <UniformGrid Columns="2" Margin="0,2">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="سعر التحويل:"/>
                        <Run Text="*" Foreground="Red" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBox x:Name="txtExchangeRate" Style="{StaticResource MandatoryTextBox}" Text="1"/>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,2">
                    <TextBlock Text="أدنى سعر تحويل:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtMinRate" Style="{StaticResource NormalTextBox}"/>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,2">
                    <TextBlock Text="أعلى سعر تحويل:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtMaxRate" Style="{StaticResource NormalTextBox}"/>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,2">
                    <TextBlock Text="عدد حالات الكسور:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtFractions" Style="{StaticResource NormalTextBox}" Text="2"/>
                </UniformGrid>
            </StackPanel>
        </Grid>

        <!-- جدول عرض العملات المتاحة في النظام -->
        <GroupBox Grid.Row="2" Header="العملات المتاحة في النظام (اضغط مرتين للتعديل)" Margin="0,0,0,10" FontWeight="Bold">
            <DataGrid x:Name="dgCurrencies" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="Column" MouseDoubleClick="DgCurrencies_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الرقم" Binding="{Binding CurrencyID}" Width="70"/>
                    <DataGridTextColumn Header="اسم العملة" Binding="{Binding CurrencyName}" Width="150"/>
                    <DataGridTextColumn Header="الرمز" Binding="{Binding Symbol}" Width="80"/>
                    <DataGridTextColumn Header="سعر التحويل" Binding="{Binding ExchangeRate}" Width="100"/>
                    <DataGridCheckBoxColumn Header="عملة الأساس" Binding="{Binding IsPrimary}" Width="90"/>
                    <DataGridTextColumn Header="الاسم الأجنبي" Binding="{Binding ForeignName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- أزرار التحكم -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="جديد / تفريغ" Width="100" Height="32" Margin="5,0,0,0" Click="BtnClear_Click"/>
            <Button x:Name="btnDelete" Content="حذف" Width="90" Height="32" Background="#C0392B" Foreground="White" FontWeight="Bold" Margin="5,0,0,0" Click="BtnDelete_Click"/>
            <Button x:Name="btnSave" Content="حفظ (إضافة)" Width="100" Height="32" Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="5,0,0,0" Click="BtnSave_Click"/>
            <Button Content="إغلاق" Width="90" Height="32" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>