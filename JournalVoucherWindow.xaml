<Window x:Class="accounting_project.JournalVoucherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سند قيد يومية" Height="650" Width="950"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" FontFamily="Segoe UI">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. رأس السند -->
        <Border Grid.Row="0" Background="White" Padding="12" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="رقم السند:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DocumentNo}" Height="30" VerticalContentAlignment="Center" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="التاريخ:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DocumentDate}" Height="30"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="رقم المرجع:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ReferenceNo}" Height="30" VerticalContentAlignment="Center" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="5" Grid.RowSpan="2">
                    <TextBlock Text="البيان العام:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding GeneralDescription}" Height="66" AcceptsReturn="True" TextWrapping="Wrap" Padding="5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. جدول القيود -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding JournalEntries}" AutoGenerateColumns="False" CanUserAddRows="True"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" RowHeight="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الحساب" Binding="{Binding AccountNo}" Width="100"/>
                    <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountName}" Width="180"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="العملة" Binding="{Binding Currency}" Width="80"/>
                    <DataGridTextColumn Header="سعر الصرف" Binding="{Binding ExchangeRate}" Width="80"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding LineDescription}" Width="*"/>
                    <DataGridTextColumn Header="نوع تحليلي" Binding="{Binding AnalyticalType}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 3. الإجماليات والفروقات -->
        <Border Grid.Row="2" Background="#1E293B" Padding="12" CornerRadius="6" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TotalDebit, StringFormat='إجمالي المدين: {0:N2}'}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalCredit, StringFormat='إجمالي الدائن: {0:N2}'}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding BalanceDifference, StringFormat='الفرق المحاسبي: {0:N2}'}" Foreground="#38BDF8" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Grid>
        </Border>

        <!-- 4. أزرار التحكم -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="إضافة سطر" Command="{Binding AddCommand}" Width="110" Height="35" Background="#0F172A" Foreground="White" FontWeight="Bold" Margin="0,0,8,0"/>
            <Button Content="حفظ القيد" Command="{Binding SaveCommand}" Width="90" Height="35" Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="0,0,8,0"/>
            <Button Content="تعديل" Command="{Binding EditCommand}" Width="80" Height="35" Margin="0,0,8,0"/>
            <Button Content="استعراض" Command="{Binding ViewCommand}" Width="80" Height="35" Margin="0,0,8,0"/>
            <Button Content="حذف سطر" Command="{Binding DeleteCommand}" Width="90" Height="35" Background="#E74C3C" Foreground="White" Margin="0,0,8,0"/>
            <Button Content="طباعة" Command="{Binding PrintCommand}" Width="80" Height="35" Margin="0,0,8,0"/>
            <Button Content="خروج" Command="{Binding ExitCommand}" Width="80" Height="35"/>
        </StackPanel>
    </Grid>
</Window>