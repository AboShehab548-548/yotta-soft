<Window x:Class="accounting_project.CompaniesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تهيئة النظام - التهيئة - بيانات الشركات" Height="620" Width="900"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- مسار الشاشة -->
        <Border Grid.Row="0" Background="#EFEFEF" Padding="8" Margin="0,0,0,15" BorderBrush="#DDD" BorderThickness="1">
            <TextBlock Text="تهيئة النظام ◄ التهيئة ◄ بيانات الشركات" FontWeight="Bold" Foreground="#333"/>
        </Border>

        <!-- محتوى الشاشة -->
        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" Background="#FDFDFD" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- قسم شعار الشركة (يسار الواجهة) -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <Border BorderBrush="#BBB" BorderThickness="1" Background="White" Height="220" Margin="0,0,0,10">
                        <Image x:Name="imgLogo" Stretch="Uniform" Source="{Binding LogoSource}"/>
                    </Border>
                    <Button Content="إدراج / تغيير الشعار" Height="30" Click="BtnUploadLogo_Click"/>
                </StackPanel>

                <!-- حقول بيانات الشركة (يمين الواجهة) -->
                <StackPanel Grid.Column="2">

                    <!-- رقم الدولة -->
                    <UniformGrid Columns="2" Margin="0,5">
                        <TextBlock Text="رقم الدولة:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <ComboBox x:Name="cmbCountry" Height="28"/>
                    </UniformGrid>

                    <!-- رقم الشركة -->
                    <UniformGrid Columns="2" Margin="0,5">
                        <TextBlock Text="رقم الشركة:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox x:Name="txtCompanyID" Height="28" VerticalContentAlignment="Center" IsReadOnly="True" Background="#EEE"/>
                    </UniformGrid>

                    <!-- اسم الشركة وخيار رئيسي -->
                    <UniformGrid Columns="2" Margin="0,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="اسم الشركة:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <CheckBox x:Name="chkIsMain" Content="رئيسي" Margin="15,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBox x:Name="txtCompanyName" Height="28" VerticalContentAlignment="Center"/>
                    </UniformGrid>

                    <!-- الاسم الأجنبي -->
                    <UniformGrid Columns="2" Margin="0,5">
                        <TextBlock Text="الاسم الأجنبي:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtForeignName" Height="28" VerticalContentAlignment="Center"/>
                    </UniformGrid>

                    <!-- الاسم المختصر -->
                    <UniformGrid Columns="2" Margin="0,5">
                        <TextBlock Text="الاسم المختصر:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtShortName" Height="28" VerticalContentAlignment="Center"/>
                    </UniformGrid>

                    <!-- الاسم الأجنبي (المختصر) -->
                    <UniformGrid Columns="2" Margin="0,5">
                        <TextBlock Text="الاسم المختصر أجنبي:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtForeignShort" Height="28" VerticalContentAlignment="Center"/>
                    </UniformGrid>

                    <!-- ملاحظات -->
                    <UniformGrid Columns="2" Margin="0,5">
                        <TextBlock Text="ملاحظات:" VerticalAlignment="Top"/>
                        <TextBox x:Name="txtNotes" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </UniformGrid>

                    <!-- رقم المجموعة -->
                    <UniformGrid Columns="2" Margin="0,5">
                        <TextBlock Text="رقم المجموعة:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtGroupID" Height="28" VerticalContentAlignment="Center" Text="1"/>
                    </UniformGrid>

                </StackPanel>
            </Grid>
        </Border>

        <!-- الأزرار السفلية -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="بحث / القائمة" Width="110" Height="32" Margin="5,0,0,0" Click="BtnSearch_Click"/>
            <Button Content="جديد / إضافة" Width="100" Height="32" Margin="5,0,0,0" Click="BtnNew_Click"/>
            <Button Content="حفظ البيانات" Width="110" Height="32" Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="5,0,0,0" Click="BtnSave_Click"/>
            <Button Content="إغلاق" Width="80" Height="32" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>