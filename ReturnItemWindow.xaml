<Window x:Class="AccountingSystem.UI.ReturnItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="استرجاع الأصناف / المرتجعات" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="#F4F6F9" FontFamily="Segoe UI">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- البحث -->
            <RowDefinition Height="*"/>
            <!-- جدول أصناف الفاتورة -->
            <RowDefinition Height="Auto"/>
            <!-- المجموع وأزرار التأكيد -->
        </Grid.RowDefinitions>

        <!-- 1. شريط البحث عن الفاتورة -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Gray" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="رقم الفاتورة:" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="0,0,10,0"/>
                <TextBox x:Name="txtInvoiceID" Grid.Column="1" Height="35" FontSize="16" VerticalContentAlignment="Center" Padding="5" KeyDown="TxtInvoiceID_KeyDown" PreviewTextInput="NumberValidationTextBox"/>
                <Button x:Name="btnSearch" Grid.Column="2" Content="بحث عن الفاتورة" Width="130" Height="35" Margin="10,0,0,0" 
                        Background="#2196F3" Foreground="White" FontWeight="Bold" Click="BtnSearch_Click"/>
            </Grid>
        </Border>

        <!-- 2. جدول تفاصيل الأصناف القابلة للإرجاع -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,15">
            <DataGrid x:Name="dgInvoiceItems" AutoGenerateColumns="False" CanUserAddRows="False" 
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="35" FontSize="14">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الصنف" Binding="{Binding ItemID}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ItemName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding SoldQty}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="تم إرجاعه سابقاً" Binding="{Binding ReturnedQty}" Width="110" IsReadOnly="True"/>

                    <!-- إدخال الكمية المراد إرجاعها -->
                    <DataGridTemplateColumn Header="الكمية المسترجعة" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ReturnQty, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0}" 
                                         PreviewTextInput="DecimalValidationTextBox"
                                         HorizontalContentAlignment="Center" FontWeight="Bold" Background="#FFFDE7"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 3. أسفل الشاشة: الإجمالي وأزرار الحفظ -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="إجمالي المبلغ المسترجع للعميل: " FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="lblTotalRefund" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="#E53935" Margin="10,0,0,0"/>
                    <TextBlock Text="ر.ي" FontSize="16" FontWeight="Bold" Margin="5,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnConfirmReturn" Content="تأكيد المرتجع وإعادة للمخزون" Width="200" Height="40" 
                            Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" Click="BtnConfirmReturn_Click"/>
                    <Button x:Name="btnCancel" Content="إلغاء" Width="90" Height="40" Margin="10,0,0,0" 
                            Background="#757575" Foreground="White" FontWeight="Bold" FontSize="14" Click="BtnCancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>