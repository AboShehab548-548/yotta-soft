<Window x:Class="accounting_project.SystemPeriodsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تهيئة النظام - التهيئة - إعداد فترات النظام" Height="680" Width="950"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- مسار الشاشة -->
        <Border Grid.Row="0" Background="#EFEFEF" Padding="8" Margin="0,0,0,10" BorderBrush="#DDD" BorderThickness="1">
            <TextBlock Text="تهيئة النظام ◄ التهيئة ◄ إعداد فترات النظام" FontWeight="Bold" Foreground="#333"/>
        </Border>

        <!-- حقول الإدخال العلوية -->
        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" Background="#F9F9F9" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <UniformGrid Columns="2" Margin="0,3">
                        <TextBlock Text="عدد الفترات:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox x:Name="txtNumOfPeriods" Height="26" VerticalContentAlignment="Center" Text="12"/>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,3">
                        <TextBlock Text="من شهر / سنة:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="txtFromMonth" Width="45" Height="26" Text="1" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="txtFromYear" Width="70" Height="26" Text="2023" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,3">
                        <TextBlock Text="إلى شهر / سنة:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="txtToMonth" Width="45" Height="26" Text="12" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="txtToYear" Width="70" Height="26" Text="2023" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <UniformGrid Columns="2" Margin="0,3">
                        <TextBlock Text="نوع الفترة الضريبية:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <ComboBox x:Name="cmbTaxPeriodType" Height="26">
                            <ComboBoxItem Content="غير مستخدم" IsSelected="True"/>
                            <ComboBoxItem Content="شهرية"/>
                            <ComboBoxItem Content="ربع سنوية"/>
                        </ComboBox>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,3">
                        <TextBlock Text="أنواع الفترات:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <ComboBox x:Name="cmbPeriodType" Height="26">
                            <ComboBoxItem Content="1 - فترات شهرية" IsSelected="True"/>
                            <ComboBoxItem Content="2 - فترات ربع سنوية"/>
                        </ComboBox>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,8">
                        <TextBlock Text=""/>
                        <Button x:Name="btnGenerate" Content="توليد البيانات" Height="28" Background="#3498DB" Foreground="White" FontWeight="Bold" Click="BtnGenerate_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- جدول عرض تفاصيل الفترات -->
        <DataGrid x:Name="dgPeriods" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="All" HeadersVisibility="Column" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الفترات" Binding="{Binding PeriodID}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="من تاريخ" Binding="{Binding FromDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                <DataGridTextColumn Header="إلى تاريخ" Binding="{Binding ToDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                <DataGridTextColumn Header="الاسم" Binding="{Binding PeriodName}" Width="140"/>
                <DataGridTextColumn Header="الاسم الأجنبي" Binding="{Binding ForeignName}" Width="140"/>
                <DataGridTextColumn Header="تاريخ بداية الفترة" Binding="{Binding FromDate, StringFormat=dd/MM/yyyy}" Width="130"/>
                <DataGridTextColumn Header="تاريخ نهاية الفترة" Binding="{Binding ToDate, StringFormat=dd/MM/yyyy}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- الأزرار السفلية -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="جديد / تفريغ" Width="100" Height="32" Margin="5,0,0,0" Click="BtnClear_Click"/>
            <Button Content="حفظ إعداد الفترات" Width="120" Height="32" Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="5,0,0,0" Click="BtnSave_Click"/>
            <Button Content="إغلاق" Width="90" Height="32" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>