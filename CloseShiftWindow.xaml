<Window x:Class="AccountingSystem.UI.CloseShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تقفيل الوردية وإغلاق الصندوق (Z-Report)" 
        Height="650" Width="480" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F4F6F9">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <TextBlock Text="تقرير إغلاق الوردية (Z-Report)" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- تفاصيل المبالغ مع ScrollViewer لمنع التداخل -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="اسم الكاشير:" FontSize="14" Foreground="#555"/>
                        <TextBlock Grid.Column="1" x:Name="txtCashierName" Text="الكاشير الحالي" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="تاريخ/وقت الفتح:" FontSize="14" Foreground="#555"/>
                        <TextBlock Grid.Column="1" x:Name="txtStartTime" Text="00:00 AM" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left"/>
                    </Grid>

                    <Separator Margin="0,8"/>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="الرصيد الافتتاحي (الفكة):" FontSize="14"/>
                        <TextBlock Grid.Column="1" x:Name="txtOpeningBalance" Text="0.00" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="إجمالي مبيعات الكاش (+):" FontSize="14" Foreground="#27AE60"/>
                        <TextBlock Grid.Column="1" x:Name="txtCashSales" Text="0.00" FontSize="14" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="إجمالي مبيعات الشبكة/الفيزا:" FontSize="14" Foreground="#2980B9"/>
                        <TextBlock Grid.Column="1" x:Name="txtCardSales" Text="0.00" FontSize="14" FontWeight="Bold" Foreground="#2980B9" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="إجمالي المرتجعات (-):" FontSize="14" Foreground="#C0392B"/>
                        <TextBlock Grid.Column="1" x:Name="txtReturns" Text="0.00" FontSize="14" FontWeight="Bold" Foreground="#C0392B" HorizontalAlignment="Left"/>
                    </Grid>

                    <Separator Margin="0,8"/>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="النقدية المتوقع وجودها بالدرج:" FontSize="15" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Grid.Column="1" x:Name="txtExpectedCash" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Left"/>
                    </Grid>

                    <StackPanel Margin="0,12,0,5">
                        <TextBlock Text="أدخل المبلغ الفعلي الموجود بالدرج:" FontSize="14" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtActualCash" FontSize="18" FontWeight="Bold" Padding="5" TextAlignment="Center" TextChanged="TxtActualCash_TextChanged"/>
                    </StackPanel>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="الفرق (زيادة / عجز):" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" x:Name="txtDifference" Text="0.00" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- أزرار التحكم -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="btnCloseShift" Content="تأكيد إغلاق الوردية" Width="180" Height="40" Background="#C0392B" Foreground="White" FontSize="14" FontWeight="Bold" Margin="5,0" Click="BtnCloseShift_Click"/>
            <Button Content="إلغاء" Width="100" Height="40" Background="#95A5A6" Foreground="White" FontSize="14" Margin="5,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>