<Window x:Class="AccountingSystem.UI.ItemSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="البحث عن صنف" Height="450" Width="650"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- حقل البحث المباشر -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="ابحث باسم الصنف أو الباركود:" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBox x:Name="txtSearch" Width="350" Height="35" FontSize="14" VerticalContentAlignment="Center"
                     TextChanged="txtSearch_TextChanged" PreviewKeyDown="txtSearch_PreviewKeyDown"/>
        </StackPanel>

        <!-- جدول عرض الأصناف -->
        <DataGrid x:Name="dgItems" SelectionMode="Extended"
          SelectionUnit="FullRow" 
          MouseDoubleClick="dgItems_MouseDoubleClick" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                    FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم الصنف" Binding="{Binding ItemID}" Width="80"/>
                <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="120"/>
                <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ItemName}" Width="*"/>
                <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="المخزون المتاح" Binding="{Binding StockQuantity}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- أزرار التحكم -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button x:Name="btnSelect" Content="اختيار [Enter]" Width="110" Height="35" Background="#28a745" Foreground="White" FontWeight="Bold" Click="btnSelect_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="إلغاء [Esc]" Width="100" Height="35" Background="#dc3545" Foreground="White" FontWeight="Bold" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>