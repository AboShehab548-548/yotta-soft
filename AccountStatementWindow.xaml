<Window x:Class="accounting_project.Views.AccountStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:accounting_project.ViewModels"
        Title="كشف حساب تفصيلي - أنظمة الأونكس المحاسبية" Height="700" Width="1050"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        Background="#F1F5F9" FontFamily="Segoe UI">

    <!-- أضف هذا السطر هنا للتأكد أن الأوامر متصلة -->
    <Window.DataContext>
        <vm:AccountStatementViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <!-- 1. الشريط العلوي -->
            <RowDefinition Height="48"/>
            <!-- 2. شريط الأزرار والأدوات -->
            <RowDefinition Height="*"/>
            <!-- 3. جدول الحركات -->
            <RowDefinition Height="40"/>
            <!-- 4. شريط الإجماليات السفلي -->
        </Grid.RowDefinitions>

        <!-- 1. الشريط العلوي -->
        <Border Grid.Row="0" Background="#0F172A">
            <Grid Margin="12,0">
                <TextBlock Text="تقرير كشف الحساب التفصيلي" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="Onyx Pro ERP - التقارير المالية" Foreground="#64748B" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 2. شريط البحث والفلترة (الفترة والحساب) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="الحساب:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBox Text="{Binding AccountCode}" Width="90" Height="26" VerticalAlignment="Center"/>
                <Button Content="🔍" Command="{Binding SearchAccountCommand}" Width="30" Height="26" Margin="4,0,15,0"/>
                <TextBlock Text="{Binding AccountName}" Foreground="DarkBlue" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Text="من تاريخ:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="130" Height="26" VerticalAlignment="Center" Margin="0,0,15,0"/>

                <TextBlock Text="إلى تاريخ:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="130" Height="26" VerticalAlignment="Center" Margin="0,0,15,0"/>

                <Button Content="عرض التقرير" Command="{Binding LoadStatementCommand}" Width="100" Height="28" Background="#2563EB" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- 3. جدول الحركات (DataGrid) -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" Background="White" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                <DataGridTextColumn Header="رقم المستند" Binding="{Binding VoucherNo}" Width="110"/>
                <DataGridTextColumn Header="نوع السند" Binding="{Binding VoucherType}" Width="110"/>
                <DataGridTextColumn Header="البيان / الشرح" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="110"/>
                <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="110"/>
                <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. شريط الإجماليات السفلي -->
        <Border Grid.Row="3" Background="#1E293B" Padding="15,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="إجمالي المدين: " Foreground="#94A3B8" FontWeight="Bold"/>
                <TextBlock Text="{Binding TotalDebit, StringFormat={}{0:N2}}" Foreground="White" FontWeight="Bold" Margin="0,0,20,0"/>

                <TextBlock Text="إجمالي الدائن: " Foreground="#94A3B8" FontWeight="Bold"/>
                <TextBlock Text="{Binding TotalCredit, StringFormat={}{0:N2}}" Foreground="White" FontWeight="Bold" Margin="0,0,20,0"/>

                <TextBlock Text="الرصيد الختامي: " Foreground="#94A3B8" FontWeight="Bold"/>
                <TextBlock Text="{Binding ClosingBalance, StringFormat={}{0:N2}}" Foreground="#38BDF8" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>